@startuml
title El Fogon Andino - faltante de insumo, mesa lista y cuenta
participant "caliente : EstacionCaliente" as caliente
participant "jefe : JefeDeCocina" as jefe
participant "estado : EstadoMesa" as estado
participant "mesero : Mesero" as mesero
participant "caja : Caja" as caja
participant "fria : EstacionFria" as fria
note over jefe : La estacion fria ya informo que sus platos estan listos.
caliente -> jefe : notificar(INSUMO_AGOTADO, fritada, mesa 7)
activate jefe
jefe -> estado : retirar(fritada)
jefe -> mesero : recibir(INSUMO_AGOTADO, fritada)
mesero --> jefe : cliente informado
jefe -> caja : recibir(RETIRAR_PLATO, fritada)
caja --> jefe : cuenta actualizada
jefe -> estado : estaLista()
estado --> jefe : true
jefe -> mesero : recibir(MESA_LISTA, mesa 7)
mesero -> jefe : notificar(PLATOS_SERVIDOS, mesa 7)
jefe -> estado : marcarServidos()
jefe --> mesero : confirmacion
deactivate jefe
note over fria : No espera la fritada retirada; conserva sus platos listos.
mesero -> jefe : notificar(CUENTA_SOLICITADA, mesa 7)
activate jefe
jefe -> estado : getServidos()
estado --> jefe : {ensalada: 1}
jefe -> caja : recibir(CUENTA_SOLICITADA, consumo = {ensalada: 1})
caja --> jefe : cuenta emitida
deactivate jefe
note over caja : La fritada retirada no se cobra.
@enduml
