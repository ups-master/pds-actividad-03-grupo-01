@startuml
title El Fogon Andino - mediador de cocina (diseno mejorado)
skinparam classAttributeIconSize 0
interface MediadorCocina <<Mediator>> {
  + registrar(componente : ComponenteCocina) : void
  + notificar(emisor : ComponenteCocina, evento : EventoCocina) : void
}
class JefeDeCocina <<ConcreteMediator>> {
  - componentes : List<ComponenteCocina>
  - estados : Map<String, EstadoMesa>
  + registrar(componente : ComponenteCocina) : void
  + notificar(emisor : ComponenteCocina, evento : EventoCocina) : void
  - despachar(evento : EventoCocina) : void
  - mesaLista(mesaId : String) : boolean
}
abstract class ComponenteCocina <<Colleague>> {
  # mediador : MediadorCocina
  + informar(evento : EventoCocina) : void
  + recibir(evento : EventoCocina) : void
  + atiende(tipo : TipoEvento) : boolean
}
class Mesero <<ConcreteColleague>> {
  + registrarPedido(pedido : PedidoMesa) : void
  + recibir(evento : EventoCocina) : void
}
class EstacionCaliente <<ConcreteColleague>> {
  + reportarFaltante(mesaId : String, plato : String) : void
  + recibir(evento : EventoCocina) : void
}
class EstacionFria <<ConcreteColleague>> {
  + recibir(evento : EventoCocina) : void
}
class Caja <<ConcreteColleague>> {
  + recibir(evento : EventoCocina) : void
  + emitirCuenta(mesaId : String) : void
}
class PedidoMesa {
  + mesaId : String
  + platos : List<String>
}
class EventoCocina {
  + tipo : TipoEvento
  + mesaId : String
  + plato : String
  + pedido : PedidoMesa
}
enum TipoEvento {
  PEDIDO_REGISTRADO
  PLATO_LISTO
  PLATOS_SERVIDOS
  INSUMO_AGOTADO
  MESA_LISTA
  RETIRAR_PLATO
  CUENTA_SOLICITADA
}
class EstadoMesa {
  - pendientes : Map<String, Integer>
  - listos : Map<String, Integer>
  - servidos : Map<String, Integer>
  - retirados : Map<String, Integer>
  + marcarListo(plato : String) : void
  + marcarServidos() : void
  + retirar(plato : String) : void
  + estaLista() : boolean
}
class Main <<Client>>
MediadorCocina <|.. JefeDeCocina
ComponenteCocina <|-- Mesero
ComponenteCocina <|-- EstacionCaliente
ComponenteCocina <|-- EstacionFria
ComponenteCocina <|-- Caja
ComponenteCocina "*" --> "1" MediadorCocina : mediador
JefeDeCocina "1" o--> "0..*" ComponenteCocina : componentes
JefeDeCocina "1" *--> "0..*" EstadoMesa : estados
ComponenteCocina ..> EventoCocina : emite / recibe
EventoCocina --> TipoEvento : tipo
EventoCocina --> "0..1" PedidoMesa : pedido
Mesero ..> PedidoMesa : registra
Main ..> JefeDeCocina : configura
note right of JefeDeCocina
  Reparte eventos a componentes registrados segun atiende().
  Itera una copia de la lista para permitir reentrada.
  Un faltante retira el plato, avisa a mesero y caja,
  y recalcula si la mesa ya puede servirse.
end note
note bottom of EstadoMesa
  Mesa lista: ningun plato pendiente; los retirados
  no cuentan como pendientes ni como servidos.
end note
@enduml
