@startuml
title Andes Market - pedido corporativo con cupon invalido
actor Cliente
participant "procesador : ProcesadorPedidos" as p
participant "stock : ValidadorStock" as s
participant "fraude : ValidadorAntifraude" as f
participant "credito : ValidadorCredito" as c
participant "direccion : ValidadorDireccion" as d
participant "cupon : ValidadorCupon" as u
Cliente -> p : procesar(pedido)
p -> s : validar(pedido)
s -> s : validarPropio(pedido) = aprobado
s -> f : validar(pedido)
note right of f : Cliente corporativo: no consulta antifraude.
f -> c : validar(pedido)
c -> c : validarPropio(pedido) = aprobado
c -> d : validar(pedido)
d -> d : validarPropio(pedido) = aprobado
d -> u : validar(pedido)
u -> u : validarPropio(pedido) = rechazado("Cupon invalido")
u --> d : rechazado
d --> c : rechazado
c --> f : rechazado
f --> s : rechazado
s --> p : rechazado
p --> Cliente : motivo del rechazo
note over u : El primer rechazo detiene la cadena.
@enduml
