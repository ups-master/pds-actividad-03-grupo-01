@startuml
title POR COMPLETAR - Escenario 1: Chain of Responsibility (secuencia)

skinparam sequenceMessageAlign left

participant "cliente : Cliente" as cli <<Client>>
participant "a : ManejadorConcretoA" as a <<ConcreteHandler>>
participant "b : ManejadorConcretoB" as b <<ConcreteHandler>>
participant "c : ManejadorConcretoC" as c <<ConcreteHandler>>

' POR COMPLETAR: reemplazar los mensajes y las notas por los del escenario.
cli -> a : POR COMPLETAR(solicitud)
activate a
note right : POR COMPLETAR: A no puede atenderla
a -> b : POR COMPLETAR(solicitud)
activate b
note right : POR COMPLETAR: B la atiende
b --> a : POR COMPLETAR(resultado)
deactivate b
a --> cli : POR COMPLETAR(resultado)
deactivate a

note over c
  C no llega a participar: la cadena se detiene
  en el primer eslabón que puede resolver la solicitud.
end note

legend right
  <<ConcreteHandler>> atiende o delega en el siguiente
  <<Client>> solo conoce el primer eslabón
endlegend

@enduml
