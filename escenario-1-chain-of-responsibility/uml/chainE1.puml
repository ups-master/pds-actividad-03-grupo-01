@startuml
title Andes Market - validacion de pedidos (propuesta original)
skinparam classAttributeIconSize 0
abstract class ValidadorPedido <<Handler>> {
  - siguiente : ValidadorPedido
  + setSiguiente(siguiente : ValidadorPedido) : ValidadorPedido
  + validar(pedido : Pedido) : ResultadoValidacion
}
class ValidadorStock <<ConcreteHandler>>
class ValidadorAntifraude <<ConcreteHandler>>
class ValidadorCredito <<ConcreteHandler>>
class ValidadorDireccion <<ConcreteHandler>>
class Pedido <<Solicitud>> {
  + total : BigDecimal
  + pagaConCredito : boolean
  + clienteCorporativo : boolean
}
class ResultadoValidacion {
  + aprobado : boolean
  + motivo : String
}
class ProcesadorPedidos <<Client>> {
  - primerValidador : ValidadorPedido
  + procesar(pedido : Pedido) : ResultadoValidacion
}
ValidadorPedido <|-- ValidadorStock
ValidadorPedido <|-- ValidadorAntifraude
ValidadorPedido <|-- ValidadorCredito
ValidadorPedido <|-- ValidadorDireccion
ValidadorPedido "0..1" --> "0..1" ValidadorPedido : siguiente
ProcesadorPedidos --> "1" ValidadorPedido : primerValidador
ValidadorPedido ..> Pedido : valida
ValidadorPedido ..> ResultadoValidacion : devuelve
note bottom of ValidadorPedido
  Propuesta inicial: delega al siguiente, pero no define
  el resultado al final ni impide enlaces circulares.
end note
@enduml
