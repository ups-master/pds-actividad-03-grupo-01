@startuml
title Andes Market - cadena de validacion de pedidos (mejorada)
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #F5F5F5
  BorderColor #555555
  BackgroundColor<<Handler>> #BBDEFB
  BackgroundColor<<ConcreteHandler>> #DCEDC8
  BackgroundColor<<Client>> #FFE0B2
  BackgroundColor<<Solicitud>> #F8BBD0
}
legend right
  |= Color |= Participante GoF |
  |<#BBDEFB>| Handler |
  |<#DCEDC8>| ConcreteHandler |
  |<#FFE0B2>| Client |
  |<#F8BBD0>| Solicitud |
  |<#F5F5F5>| No es rol GoF |
endlegend
package "Roles del patrón (GoF)" {
  class ProcesadorPedidos <<Client>> {
    - primerValidador : ValidadorPedido
    + procesar(pedido : Pedido) : ResultadoValidacion
  }
  abstract class ValidadorPedido <<Handler>> {
    - siguiente : ValidadorPedido
    + setSiguiente(siguiente : ValidadorPedido) : ValidadorPedido
    + validar(pedido : Pedido) : ResultadoValidacion
    # validarPropio(pedido : Pedido) : ResultadoValidacion
  }
  class ValidadorStock <<ConcreteHandler>> {
    - inventario : Inventario
    # validarPropio(pedido : Pedido) : ResultadoValidacion
  }
  class ValidadorAntifraude <<ConcreteHandler>> {
    - antifraude : ServicioAntifraude
    # validarPropio(pedido : Pedido) : ResultadoValidacion
  }
  class ValidadorCredito <<ConcreteHandler>> {
    # validarPropio(pedido : Pedido) : ResultadoValidacion
  }
  class ValidadorDireccion <<ConcreteHandler>> {
    - cobertura : CoberturaEntrega
    # validarPropio(pedido : Pedido) : ResultadoValidacion
  }
  class ValidadorCupon <<ConcreteHandler>> {
    - cupones : ServicioCupones
    # validarPropio(pedido : Pedido) : ResultadoValidacion
  }
  class Pedido <<Solicitud>> {
    + productos : List<LineaPedido>
    + total : BigDecimal
    + pagaConCredito : boolean
    + clienteCorporativo : boolean
    + cupoDisponible : BigDecimal
    + direccion : String
    + cupon : String
  }
}
package "Datos de la solicitud y del resultado (no son roles GoF)" {
  class LineaPedido {
    + productoId : String
    + cantidad : int
  }
  class ResultadoValidacion {
    + aprobado : boolean
    + motivo : String
    + aprobado() : ResultadoValidacion
    + rechazado(motivo : String) : ResultadoValidacion
  }
}
package "Dependencias de las reglas (no son roles GoF)" {
  interface Inventario {
    + hayStock(pedido : Pedido) : boolean
  }
  interface ServicioAntifraude {
    + esSospechoso(pedido : Pedido) : boolean
  }
  interface CoberturaEntrega {
    + atiende(direccion : String) : boolean
  }
  interface ServicioCupones {
    + esValido(pedido : Pedido) : boolean
  }
}
ValidadorPedido <|-- ValidadorStock
ValidadorPedido <|-- ValidadorAntifraude
ValidadorPedido <|-- ValidadorCredito
ValidadorPedido <|-- ValidadorDireccion
ValidadorPedido <|-- ValidadorCupon
ValidadorPedido "0..1" --> "0..1" ValidadorPedido : siguiente
ProcesadorPedidos --> "1" ValidadorPedido : primerValidador
ValidadorStock --> "1" Inventario
ValidadorAntifraude --> "1" ServicioAntifraude
ValidadorDireccion --> "1" CoberturaEntrega
ValidadorCupon --> "1" ServicioCupones
ValidadorPedido ..> Pedido : valida
Pedido "1" *--> "1..*" LineaPedido : productos
ValidadorPedido ..> ResultadoValidacion : devuelve
note left of ProcesadorPedidos
  Conoce solo el primer eslabon. Cadena de ejemplo:
  stock -> antifraude -> credito -> direccion -> cupon
end note
note right of ValidadorPedido
  validar: un rechazo detiene la cadena,
  una aprobacion delega y sin siguiente aprueba.
  setSiguiente rechaza ciclos y autoenlaces.
end note
note bottom of ValidadorAntifraude
  Cliente corporativo: omite la consulta
  antifraude y continua.
end note
note bottom of ValidadorCupon
  Eslabon opcional: se inserta sin
  cambiar los demas validadores.
end note
@enduml
