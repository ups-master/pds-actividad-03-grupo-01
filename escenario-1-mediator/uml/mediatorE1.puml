@startuml
title POR COMPLETAR - Escenario 1: Mediator

skinparam classAttributeIconSize 0
skinparam linetype ortho

' POR COMPLETAR: renombrar cada clase con el dominio del enunciado y agregar atributos y operaciones.

interface Mediador <<Mediator>> {
    ' POR COMPLETAR: operaciones, p. ej. + registrar(colega : Colega) : void
}

class MediadorConcreto <<ConcreteMediator>> {
    ' POR COMPLETAR: - colegas : List<Colega>
}

abstract class Colega <<Colleague>> {
    ' POR COMPLETAR: - mediador : Mediador
}

class ColegaConcretoA <<ConcreteColleague>> {
    ' POR COMPLETAR
}

class ColegaConcretoB <<ConcreteColleague>> {
    ' POR COMPLETAR
}

class Main <<Client>> {
    + {static} main(args : String[]) : void
}

Mediador <|.. MediadorConcreto
Colega <|-- ColegaConcretoA
Colega <|-- ColegaConcretoB
' atributo Colega.mediador
Colega "*" --> "1" Mediador : mediador
' atributo MediadorConcreto.colegas
MediadorConcreto "1" o--> "0..*" Colega : colegas
Main ..> MediadorConcreto : crea
Main ..> ColegaConcretoA : crea
Main ..> ColegaConcretoB : crea

legend right
  <<Mediator>> define cómo se comunican los participantes
  <<ConcreteMediator>> coordina la comunicación y conoce a los participantes
  <<Colleague>> conoce solo al mediador, no a los demás
  <<ConcreteColleague>> participante concreto
  <<Client>> arma el mediador y registra a los colegas
endlegend

@enduml
